# Stage 1: Generate baselines
FROM python:3.12-windowsservercore-ltsc2022 as baseline-builder

ENV PYTHONUTF8=1
WORKDIR /build

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir openpyxl pandas

COPY backend backend
COPY tools tools
COPY baselines baselines

# ← แก้ชื่อ script และ path data ให้ถูก
RUN python tools/convert_baselines.py \
    --data-dir backend/data \
    --output-dir baselines/generated

# Stage 2: Backend runtime
FROM python:3.12-windowsservercore-ltsc2022

ENV PYTHONUTF8=1
WORKDIR C:/MicrosoftScanEngine/backend

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir openpyxl bcrypt==4.0.1

COPY backend .

# Copy generated baselines from stage 1
COPY --from=baseline-builder /build/baselines/generated baselines/generated

EXPOSE 8000

CMD ["powershell", "-ExecutionPolicy", "Bypass", "-File", "start.ps1"]