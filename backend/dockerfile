FROM python:3.12-windowsservercore-ltsc2022


ENV PYTHONUTF8=1
WORKDIR C:/MicrosoftScanEngine/backend

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir openpyxl bcrypt==4.0.1
RUN pip install --no-cache-dir llama-cpp-python --extra-index-url https://abetlen.github.io/llama-cpp-python/whl/cpu

COPY . .

EXPOSE 8000
 
CMD ["powershell", "-ExecutionPolicy", "Bypass", "-File", "start.ps1"] 

