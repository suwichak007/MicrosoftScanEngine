GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# local, ldap, or hybrid
AUTH_PROVIDER=hybrid
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LDAP / Active Directory
LDAP_SERVER_URI=ldap://dc01.example.local:389
LDAP_DOMAIN=EXAMPLE
LDAP_BIND_DN=CN=ldap-reader,OU=Service Accounts,DC=example,DC=local
LDAP_BIND_PASSWORD=change-me
LDAP_USER_BASE_DN=DC=example,DC=local
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_DEFAULT_ROLE=viewer
LDAP_ADMIN_GROUP_DN=CN=SecureScan Admins,OU=Groups,DC=example,DC=local

# Development-only LDAP mock for testing before real Azure AD DS/LDAP is ready.
# Login examples:
#   azure.admin@example.com / Test@12345
#   azure.viewer@example.com / Test@12345
LDAP_MOCK_ENABLED=false
LDAP_MOCK_USERS=azure.admin@example.com:Test@12345:admin:Azure Admin:azure.admin@example.com,azure.viewer@example.com:Test@12345:viewer:Azure Viewer:azure.viewer@example.com
